{
  "target": "esp32_c3fh4_idf",
  "board": "ESP32 C3FH4",
  "backend": "esp_idf",
  "cc": {
    "name": "idf",
    "path": "idf.py",
       "args": [
      "set-target esp32c3",
      "build"
    ]
  },
  "flasher": {
    "name": "idf",
    "path": "idf.py",
    "args": "-p @{port} flash"
  },
  "api_paths": [
    "weact_studio/esp32_c3fh4_idf",
    "espressif/esp_idf/core"
  ],
  "v_defines": [],
  "default_cpu_freq": 16000000,
  "default_string_len": 50,
  "compiler_setup_path": "setup/esp_idf.json"
}